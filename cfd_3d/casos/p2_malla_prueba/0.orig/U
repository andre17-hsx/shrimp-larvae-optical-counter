FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
dimensions [0 1 -1 0 0 0 0];
#include "include/condiciones"
internalField uniform (0 0 0);
boundaryField
{
    inlet
    {
        type variableHeightFlowRateInletVelocity;
        flowRate $inletFlowRate;
        alpha alpha.water;
        value uniform (0 0 0);
    }
    outlet
    {
        type zeroGradient;
    }
    atmosphere
    {
        type pressureInletOutletVelocity;
        value uniform (0 0 0);
    }
    symmetry
    {
        type symmetry;
    }
    malla
    {
        type noSlip;
    }
    fondo
    {
        type zeroGradient;
    }
    paredes
    {
        type noSlip;
    }
}
