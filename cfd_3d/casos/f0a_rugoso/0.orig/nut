FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions [0 2 -1 0 0 0 0]; internalField uniform 0;
boundaryField
{
    inletWater { type calculated; value uniform 0; }
    bottom { type nutkRoughWallFunction; Ks uniform 5e-05; Cs uniform 0.5; value uniform 0; }
    atmosphere { type calculated; value uniform 0; }
    outlet { type calculated; value uniform 0; }
    frontAndBack { type empty; }
}
