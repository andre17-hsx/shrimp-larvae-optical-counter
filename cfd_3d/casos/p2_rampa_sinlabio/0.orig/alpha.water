FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
dimensions [0 0 0 0 0 0 0];
internalField uniform 0;
boundaryField
{
    inlet
    {
        type variableHeightFlowRate;
        lowerBound 0;
        upperBound 1;
        value uniform 0;
    }
    outlet
    {
        type zeroGradient;
    }
    atmosphere
    {
        type inletOutlet;
        inletValue uniform 0;
        value uniform 0;
    }
    symmetry
    {
        type symmetry;
    }
    malla
    {
        type zeroGradient;
    }
    fondo
    {
        type zeroGradient;
    }
    paredes
    {
        type zeroGradient;
    }
}
